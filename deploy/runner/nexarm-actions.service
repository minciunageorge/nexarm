[Unit]
Description=Nexarm GitHub ARM64 read-only runner (no deployment)
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
User=nexarm-runner
Group=nexarm-runner
WorkingDirectory=/var/lib/nexarm-runner/actions-runner
# Test the kernel flag and the exact read-only sudo path INSIDE this sandbox.
ExecStartPre=/usr/bin/python3 -I -c 'import pathlib; flag = next(line for line in pathlib.Path("/proc/self/status").read_text().splitlines() if line.startswith("NoNewPrivs:")); assert flag.split()[1] == "0", "Service sandbox forbids approved read-only sudo"'
ExecStartPre=/usr/bin/sudo -n /usr/local/sbin/nexarm-readonly probe
ExecStart=/var/lib/nexarm-runner/actions-runner/run.sh
Restart=always
RestartSec=15
KillMode=control-group
TimeoutStopSec=60
UMask=0077
StandardInput=null
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/nexarm-runner
PrivateTmp=yes
ProtectControlGroups=yes
# Seccomp-based hardening can implicitly force NNP on systemd 252/254.
# Do not re-add it here or grant capabilities to bypass it. Cgroup device access
# and filesystem isolation remain restricted without disabling setuid sudo.
DevicePolicy=closed
# sudoers still permits ONLY the three fixed read-only broker commands.
NoNewPrivileges=no
TasksMax=128
MemoryMax=512M
CPUQuota=50%

[Install]
WantedBy=multi-user.target
